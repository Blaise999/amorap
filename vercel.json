{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.py?amora_path=api/:path*" },
    { "source": "/uploads/:path*", "destination": "/api/index.py?amora_path=uploads/:path*" }
  ],
  "headers": [
    { "source": "/api/(.*)", "headers": [
      { "key": "Cache-Control", "value": "no-store" },
      { "key": "X-Content-Type-Options", "value": "nosniff" }
    ] },
    { "source": "/admin/(.*)", "headers": [
      { "key": "Cache-Control", "value": "no-store" }
    ] }
  ]
}
